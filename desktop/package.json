{
  "name": "aurafarm-pet",
  "version": "0.1.0",
  "description": "Aurafarm desktop pet for Mac",
  "author": "Aurafarm",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "node ensure-apple-events.js && electron .",
    "pack": "node pack.js",
    "pack:signed": "node pack.js --signed"
  },
  "build": {
    "appId": "app.aurafarm.pet",
    "productName": "Aurafarm",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/**"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        "zip"
      ],
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Aurafarm reads the address of the front Safari, Chrome, or Edge tab during a study session.",
        "CFBundleURLTypes": [
          {
            "CFBundleURLName": "Aurafarm",
            "CFBundleURLSchemes": [
              "aurafarm"
            ]
          }
        ]
      }
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0"
  },
  "devDependencies": {
    "electron": "^35.7.5",
    "electron-builder": "^26.0.12"
  }
}
