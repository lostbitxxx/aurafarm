Windows Registry Editor Version 5.00

; Edit the exe path, then double-click this file. It registers aurafarm://
; for the current user only.

[HKEY_CURRENT_USER\Software\Classes\aurafarm]
@="URL:Aurafarm"
"URL Protocol"=""

[HKEY_CURRENT_USER\Software\Classes\aurafarm\shell\open\command]
@="\"C:\\Aurafarm\\aurafarm.exe\" \"%1\""
