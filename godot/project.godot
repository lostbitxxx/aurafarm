; Engine configuration file.
; Godot 4.5.2-stable. Stay on this editor for the web export in this phase.

config_version=5

[application]

config/name="Aurafarm"
run/main_scene="res://scenes/web_pet.tscn"
config/features=PackedStringArray("4.5", "GL Compatibility")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="canvas_items"
window/size/window_width_override=640
window/size/window_height_override=360

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
