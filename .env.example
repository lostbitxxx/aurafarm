NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Older projects can use the anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# Lets registration insert public.profiles and public.user_pets even when
# email confirmation means there is no user session yet.
SUPABASE_SECRET_KEY=sb_secret_replace_me
# SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Absolute URL of the Mac pet zip. Host the file outside this app.
# NEXT_PUBLIC_PET_DOWNLOAD_URL=https://example.com/aurafarm-mac.zip
